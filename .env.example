# Frontend values only. Copy to .env.local and choose the intended deployment.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set these in the Convex deployment, not in VITE_* variables:
# SITE_URL=https://hopsession.cc (http://localhost:5173 for local development)
# BETTER_AUTH_SECRET=<random secret of at least 32 bytes>
# AUTH_GOOGLE_ID=<existing Google OAuth client ID>
# AUTH_GOOGLE_SECRET=<existing Google OAuth client secret>
# AUTH_RESEND_KEY=<existing Resend API key>
# BETTER_AUTH_API_KEY=<optional Better Auth dashboard key; server-only>
# AUTH_MIGRATION_COMPLETE=false (set true only after the migration inventory passes)
# FIRECRAWL_API_KEY=<existing server-only Firecrawl key>
